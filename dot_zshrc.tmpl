# ===== History =====

HISTSIZE=10000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE

# History options
setopt append_history share_history
setopt hist_ignore_space hist_ignore_all_dups hist_find_no_dups
setopt inc_append_history_time


# ===== Shell Options =====

setopt correct
setopt auto_cd


# ===== PATH =====

typeset -U path PATH

path=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "${KREW_ROOT:-$HOME/.krew}/bin"
    $path
)

{{- if eq .chezmoi.os "darwin" }}
[[ -d "$HOME/.lmstudio/bin" ]] && path+=("$HOME/.lmstudio/bin")
{{- end }}


# ===== Homebrew =====

# Load Homebrew before Starship, Carapace and zoxide

{{- if eq .chezmoi.os "linux" }}
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export XDG_DATA_DIRS="/home/linuxbrew/.linuxbrew/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
export XDG_DATA_DIRS="/opt/homebrew/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
{{- end }}


# ===== Real Linux TTY =====

{{- if eq .chezmoi.os "linux" }}
# Set font only in real Linux TTY
if [[ "$TERM" == "linux" && -z "$ZSH_TTY_FONT_SET" ]]; then
  setfont ter-v16b
  export ZSH_TTY_FONT_SET=1
fi

# Clean prompt for real Linux TTY
if [[ "$TERM" == "linux" ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship-tty.toml"
else
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
fi
{{- end }}


# ===== Starship =====

# Load after PATH and Homebrew

(( $+commands[starship] )) && eval "$(starship init zsh)"


# ===== Zinit =====

### Added by Zinit's installer

if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https\://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load required annexes
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

### End of Zinit's installer chunk


# ===== Completion Plugins =====

# Load completion definitions before compinit
zinit light zsh-users/zsh-completions


# ===== Completion System =====

# Run full compinit once per day
autoload -Uz compinit

if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi


# ===== Carapace =====

# Native completions still take priority via fpath; Carapace fills the gaps
# export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
#
# if command -v carapace >/dev/null; then
#     zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
#     source <(carapace _carapace zsh)
# fi


# ===== fzf Key Bindings =====

# Use the built-in Zsh integration
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
else
    if (( $+commands[brew] )); then
        fzf_bindings="$(brew --prefix fzf 2>/dev/null)/shell/key-bindings.zsh"
        [[ -f "$fzf_bindings" ]] && source "$fzf_bindings"
    fi
fi

# Bind Ctrl+R if the widget exists
(( ${+widgets[fzf-history-widget]} )) && bindkey '^R' fzf-history-widget


# ===== fzf-tab plugin =====

# Load after compinit and fzf
zinit light Aloxaf/fzf-tab

# Bind Tab to fzf-tab
bindkey '^I' fzf-tab-complete


# ===== Plugins =====

# Load ZLE plugins after fzf-tab
zinit light zsh-users/zsh-autosuggestions
zinit light none9632/zsh-sudo


# ===== fzf-tab =====

# History preview
zstyle ':fzf-tab:complete:history:*' fzf-preview 'fc -l 1 | tac; tail -n 5000 ~/.zsh_history | tac'
zstyle ':fzf-tab:complete:history:*' fzf-switch '1'

# Directory previews
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'


# ===== Completion Options =====

eval "$(dircolors -b)"
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no


# ===== Aliases =====

alias wttr='curl -s wttr.in'
alias k='kubecolor'
{{- if eq .chezmoi.os "darwin" }}
alias mc='mc -u -X'
alias mcz='. "$(brew --prefix)/opt/midnight-commander/libexec/mc/mc-wrapper-zsh.sh"'
{{- end }}

# ===== Tools =====

# zoxide integration
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)" # zoxide integration for smart cd
(( $+commands[rgrc] )) && eval "$(rgrc --aliases)"    # Generic Colourizer in Rust
unalias kubectl 2>/dev/null                               # FIX rgrc's colorized wrapper breaks carapace's `kubectl __complete` parsing


# ===== System Exports =====

export AGE_KEY_FILE="$HOME/.config/sops/age/key.txt"
export ANSIBLE_VAULT_PASSWORD_FILE="$HOME/.ansible_vault/.vault_passw"


# ===== Yazi =====

function y() {
        local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
        yazi "$@" --cwd-file="$tmp"
        IFS= read -r -d '' cwd < "$tmp"
        [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
        rm -f -- "$tmp"
}


# ===== Zinit Update =====

function zinit-update() {
  printf "🔄 Updating Zinit and plugins..."
  zinit self-update && zinit update --all
  printf "✅ All Zinit plugins updated!"
}


# ===== Homebrew Upgrade =====

brew-smart-upgrade() {
    local failed=()

    for pkg in $(brew outdated); do
        echo "🔄 Upgrading $pkg ..."

        if brew upgrade "$pkg"; then
            echo "✓ $pkg upgraded"
        else
            echo "✗ $pkg failed"
            failed+=("$pkg")
        fi

        echo
    done

    if (( ${#failed[@]} > 0 )); then
        echo "Failed packages:"
        printf ' - %s\n' "$failed[@]"
    else
        echo "✅ All packages upgraded successfully."
    fi
}

zsh-doctor() {
    local tool
    local -a tools=(
        git
        zsh
        starship
        fzf
        eza
        zoxide
        rgrc
        brew
    )

    print "Zsh's Dependencies:"

    for tool in "${tools[@]}"; do
        if (( $+commands[$tool] )); then
            printf '  [ok ✓ ]      %-15s %s\n' "$tool" "${commands[$tool]}"
        else
            printf '  [missing ✗] %s\n' "$tool"
        fi
    done

    print
    print 'Zinit:'

    if [[ -f "$HOME/.local/share/zinit/zinit.git/zinit.zsh" ]]; then
        print '  [ok ✓ ]      zinit'
    else
        print '  [missing ✗] zinit'
    fi
}

# ===== Syntax Highlighting =====

# Must be loaded last
zinit light zdharma-continuum/fast-syntax-highlighting
