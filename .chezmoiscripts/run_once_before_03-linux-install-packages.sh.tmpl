#!{{ lookPath "sh" }}

# set -euo pipefail

# Colors
GREEN="\033[0;32m"
RED="\033[0;31m"
NC="\033[0m" # No Color

{{ if eq .chezmoi.os "linux" -}}

# ---- System packages (apt / pacman) ----
if command -v pacman >/dev/null 2>&1; then
  if [ {{ len .packages.linux.pacman }} -gt 0 ]; then
    printf "\n${GREEN}Installing system packages (pacman)...${NC}\n\n"
    sudo pacman -Syu --noconfirm
    xargs -r sudo pacman -S --noconfirm --needed <<'EOF'
{{- range .packages.linux.pacman }}
{{ . }}
{{- end }}
EOF
  fi

elif command -v apt-get >/dev/null 2>&1; then
  if [ {{ len .packages.linux.apt }} -gt 0 ]; then
    printf "\n${GREEN}Installing system packages (apt)...${NC}\n\n"
    sudo apt-get update -y
    xargs -r sudo apt-get install -y <<'EOF'
{{- range .packages.linux.apt }}
{{ . }}
{{- end }}
EOF
  fi

else
  printf "\n${RED}No supported package manager found (apt or pacman).${NC}\n\n"
fi

{{ end }}
